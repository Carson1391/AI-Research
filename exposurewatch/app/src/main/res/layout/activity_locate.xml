<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <com.google.android.material.button.MaterialButton android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" />

        <TextView android:id="@+id/txtName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Source"
            android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp" app:strokeColor="@color/stroke" app:strokeWidth="1dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CLAIMED IDENTITY  (spoofable)" android:textColor="@color/text_secondary"
                    android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08" />
                <TextView android:id="@+id/txtClaimMac" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="MAC/BSSID:" android:textColor="@color/text_primary"
                    android:textSize="14sp" android:fontFamily="monospace" />
                <TextView android:id="@+id/txtClaimVendor" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="OUI vendor:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/txtClaimName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="SSID/name:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/txtClaimType" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Type:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp" app:strokeColor="@color/accent" app:strokeWidth="1dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BEHAVIOR  (what to trust)" android:textColor="@color/accent"
                    android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08" />
                <TextView android:id="@+id/txtBehSeen" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Seen:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/txtBehLocations" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Locations:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/txtBehRssi" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="RSSI shape:"
                    android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="monospace" />
                <TextView android:id="@+id/txtBehFollows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Follows you:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/txtBehHome" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Only near home:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/txtBehUnlock" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Appears with unlock/motion:"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/txtBehContexts" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Baselines:"
                    android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/txtRssi" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center"
            android:text="dBm" android:textColor="@color/accent" android:textSize="44sp"
            android:textStyle="bold" android:fontFamily="monospace" />
        <ProgressBar android:id="@+id/barStrength" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginTop="6dp"
            android:max="100" android:progress="0" android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/stroke" />
        <TextView android:id="@+id/txtDistance" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
            android:text="distance" android:textColor="@color/text_primary" android:textSize="15sp" />
        <TextView android:id="@+id/txtPeak" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:text="peak:"
            android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/txtGuidance" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="Walk slowly around - the number climbs as you get closer. Sweep low and high: vents, smoke detectors, fixtures, outlets."
            android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
